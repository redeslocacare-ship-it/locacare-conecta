# Copie para .env e preencha. O .env nunca deve ser versionado.

# Chaves públicas — vão para o bundle do navegador, protegidas por RLS no banco.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key"

# Segredos — apenas para scripts locais/CI. NUNCA no frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://...
# SUPABASE_DB_PASSWORD=
